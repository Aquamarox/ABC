#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

static int WriteAll(const int fd, const char *data, const size_t size)
{
    size_t done = 0;
    while (done < size)
    {
        const ssize_t w = write(fd, data + done, size - done);
        if (w < 0)
        {
            return -1;
        }
        done += (size_t)w;
    }
    return 0;
}

int main(const int argc, char **argv)
{
    if (argc < 3)
    {
        return 1;
    }

    const char *src = argv[1];
    const char *dst = argv[2];

    struct stat st;
    if (stat(src, &st) != 0)
    {
        return 2;
    }

    const int fdSrc = open(src, O_RDONLY);
    if (fdSrc < 0)
    {
        return 3;
    }

    const int fdDst = open(dst, O_WRONLY | O_CREAT | O_TRUNC, st.st_mode & 0777);
    if (fdDst < 0)
    {
        close(fdSrc);
        return 4;
    }

    const size_t bufSize = 32;
    char buffer[bufSize];

    while (1)
    {
        const ssize_t r = read(fdSrc, buffer, bufSize);
        if (r < 0)
        {
            close(fdSrc);
            close(fdDst);
            return 5;
        }
        if (r == 0)
        {
            break;
        }
        if (WriteAll(fdDst, buffer, (size_t)r) != 0)
        {
            close(fdSrc);
            close(fdDst);
            return 6;
        }
    }

    close(fdSrc);
    close(fdDst);
    return 0;
}
